{
  "_comment": "Single source of truth for the SEU x NARI presentation template. All three deliverables (concept boards HTML, .pptx, beamer .sty) derive their values from this file. Do not hand-copy values into consumers.",
  "meta": {
    "name": "东南大学 x 国网电科院（南瑞）研究生汇报模板",
    "version": "1.0.0",
    "slide": { "width_in": 13.3333, "height_in": 7.5, "width_pt": 960, "height_pt": 540 },
    "ratio": "16:9"
  },

  "color": {
    "surface":        { "hex": "#FFFFFF", "role": "页面底色 / 浅净底" },
    "surface-alt":    { "hex": "#F5F7F1", "role": "次级底：表格隔行、注释区" },
    "surface-card":   { "hex": "#EAF0E3", "role": "卡片/块底（primary 极浅色）" },
    "ink":            { "hex": "#1A1A1A", "role": "正文" },
    "ink-muted":      { "hex": "#6B6B6B", "role": "注释、面包屑、图表注" },
    "ink-faint":      { "hex": "#9AA09A", "role": "页码、极弱信息" },
    "rule":           { "hex": "#E4E4DE", "role": "细分割线 0.75pt" },
    "rule-strong":    { "hex": "#CFD3C8", "role": "稍强分割线 / 表格框线" },

    "primary":        { "hex": "#4D7C2B", "role": "东大绿 · 主色" },
    "primary-dark":   { "hex": "#3E6623", "role": "绿底上的正文色（对比度安全）" },
    "primary-light":  { "hex": "#7BA05B", "role": "次级绿 / 图表第二色" },
    "primary-tint":   { "hex": "#EAF0E3", "role": "主色淡底（= surface-card）" },

    "secondary":      { "hex": "#00807C", "role": "南瑞墨绿 · 辅色" },
    "secondary-dark": { "hex": "#00615E", "role": "辅色深阶" },
    "secondary-tint": { "hex": "#E3F1F0", "role": "辅色淡底" },

    "accent":         { "hex": "#C9A227", "role": "金 · 仅作细线/装饰，绝不作文字" },
    "accent-soft":    { "hex": "#E3C46A", "role": "浅金" },

    "alert":          { "hex": "#B23A2E", "role": "警示（alertblock / 批注）" },
    "white":          { "hex": "#FFFFFF", "role": "反白文字" },

    "data-series": {
      "role": "图表分类色序（与绿色主轴协调）",
      "values": ["#4D7C2B", "#00807C", "#C9A227", "#7BA05B", "#66B2B2", "#8C6D1F", "#9AA09A"]
    }
  },

  "contrast": {
    "_note": "实测值（由 design/generate_latex_colors.py --check 复算并校验，改动色值后必须重跑）。",
    "white-on-primary":    { "ratio": 5.0, "passes": "AA", "rule": "达标；但投影环境仍建议白字只用于 >=20pt 标题" },
    "white-on-secondary":  { "ratio": 4.8, "passes": "AA", "rule": "同上" },
    "ink-on-surface":      { "ratio": 17.4, "passes": "AAA" },
    "ink-on-surface-card": { "ratio": 15.0, "passes": "AAA" },
    "greenDark-on-card":   { "ratio": 5.8, "passes": "AA" },
    "accent-on-surface":   { "ratio": 2.4, "passes": "decorative-only", "rule": "金色永不用于文字或承载信息的图形" },
    "inkMuted-on-surface": { "ratio": 5.3, "passes": "AA" }
  },

  "type": {
    "_note": "pt，按 960x540pt 版面。CJK 用 Noto Sans SC，西文/数字用 TeX Gyre Pagella (Palatino)。",
    "_font-note": "First entry is the face actually written into the pptx. It must be resolvable by PowerPoint on Windows — do NOT use TeX Gyre Pagella here, it ships only with TeX Live and would silently fall back to a default serif.",
    "cjk-stack":   ["Noto Sans SC", "Microsoft YaHei", "sans-serif"],
    "latin-stack": ["Palatino Linotype", "Palatino", "serif"],
    "scale": {
      "cover-title":      40,
      "cover-kicker":     15,
      "section-numeral":  72,
      "section-title":    36,
      "slide-title":      28,
      "slide-breadcrumb": 13,
      "subtitle":         20,
      "body":             16,
      "body-small":       14,
      "caption":          11,
      "page-number":      10,
      "stat-large":       56,
      "stat-mid":         40
    },
    "weight": { "title": "bold", "body": "regular", "emphasis": "bold" },
    "line-height": { "body": 1.45, "title": 1.2 }
  },

  "layout": {
    "margin_outer_in":  0.55,
    "margin_top_in":    0.75,
    "margin_bottom_in": 0.62,
    "content_width_in": 10.0,
    "gutter_in":        0.28,
    "baseline_pt":      18,
    "title-rule": { "width_in": 2.0, "thickness_pt": 1.5, "color": "accent" },
    "hairline_pt": 0.75,
    "logo": {
      "seu":  { "h_in": 0.78, "anchor": "top-right", "offset_in": [0.55, 0.22] },
      "nari": { "h_in": 0.34, "anchor": "bottom-left", "offset_in": [0.55, 0.18] }
    },
    "progress-bar": {
      "_note": "pptx: 段数固定、填充编码在『版式』上，插页不破。beamer: 由 smoothbars miniframe 自动生成。",
      "segments": 6,
      "height_in": 0.075,
      "gap_in": 0.045,
      "anchor": "top-left",
      "offset_in": [0.55, 0.26]
    }
  },

  "motif": {
    "_note": "呼应东大现有模板的绿黄几何菱形，但克制：仅封面/过渡页/尾页出现，内容页不用。",
    "enabled": true,
    "shapes": ["rotated-square-primary", "rotated-square-accent", "rotated-square-outline"],
    "max_on_slide": 3
  }
}
